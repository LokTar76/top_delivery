
erDiagram

    SHIPMENT ||--o{ SHIPMENT_PACKAGE : contains
    SHIPMENT ||--o{ CARGO_PROCESS : has
    SHIPMENT ||--o{ SHIPMENT_EXTRA_DATA : has
    SHIPMENT ||--o{ SHIPMENT_EVENT : records
    SHIPMENT ||--o{ MANIFEST_SHIPMENT: has

    CARGO_PROCESS ||--o{ SHIPMENT_ATTEMPT_PACKAGE : includes
    CARGO_PROCESS ||--o{ SHIPMENT_EVENT : records

    SHIPMENT_PACKAGE ||--o{ PACKAGE_SCAN : has
    SHIPMENT_PACKAGE ||--o{ SHIPMENT_ATTEMPT_PACKAGE : assigned_in

    DELIVERY_SCHEDULE ||--o{ SCHEDULE_EVENT : records
    DELIVERY_SCHEDULE }o--|| ORG : assigned_to
    DELIVERY_SCHEDULE }o--|| USER: deliverd_by

    ORG ||--o{ SHIPMENT: creates

    ADDRESS ||--o{ SHIPMENT: cnee
    ADDRESS ||--o{ SHIPMENT: cnor

    DELIVERY_SCHEDULE ||--o{ DELIVERY_SCHEDULE_RELATION : has
    CARGO_PROCESS ||--o{ DELIVERY_SCHEDULE_RELATION : scheduled_as
    MANIFEST ||--o{ MANIFEST_SHIPMENT: has
    MANIFEST ||--o{ ORG: customer
    MANIFEST ||--o{ USER: created_by

    SHIPMENT {
        bigint id PK
        varchar ref
        varchar hbn
        int status
        int depot_id FK
        int agent_id FK 
        int cnee_id FK
        int cnor_id FK
        int receiver_id FK
        int notify_id FK
        tinyint type
        varchar cref
        int total_packages
        decimal total_weight
        decimal total_cbm
        json mdata
        datetime created_at
    }

    SHIPMENT_PACKAGE {
        bigint id PK
        bigint shipment_id FK
        varchar barcode
        int package_no
        decimal weight
        decimal length
        decimal width
        decimal height
        int status
        datetime created_at
    }

    CARGO_PROCESS {
        bigint id PK
        bigint shipment_id FK
        varchar attempt_ref
        int attempt_no
        int status
        tinyint type
        int depot_id
        bigint parent_attempt_id
        datetime created_at
        datetime completed_at
        json mdata
    }

    SHIPMENT_ATTEMPT_PACKAGE {
        bigint id PK
        bigint attempt_id FK
        bigint package_id FK
        int expected_scan
        int scanned
        datetime scanned_at
    }

    DELIVERY_SCHEDULE {
        bigint id PK
        varchar schedule_no
        varchar schedule_name
        text description
        int status
        json mdata
        datetime create_time
        int depot_id FK
        int type
        int driver_id FK
        int dsp_id FK
        datetime pickup_time
        datetime start_delivery_time
        datetime completed_at
    }

    DELIVERY_SCHEDULE_RELATION {
        bigint id PK
        bigint schedule_id FK
        bigint cargo_process_id FK
        datetime created
        int sequence
        tinyint active
    }

    PACKAGE_SCAN {
        bigint id PK
        bigint package_id FK
        bigint attempt_id FK
        bigint schedule_id FK
        bigint driver_id FK
        varchar scan_type
        varchar barcode
        datetime scanned_at
        decimal lat
        decimal lng
        json raw_data
    }

    SHIPMENT_EVENT {
        bigint id PK
        bigint shipment_id FK
        bigint attempt_id FK
        varchar event_type
        varchar source
        bigint operator_id
        datetime event_time
        json data
    }

    SCHEDULE_EVENT {
        bigint id PK
        bigint schedule_id FK
        varchar event_type
        varchar source
        bigint operator_id
        datetime event_time
        json data
    }

    SHIPMENT_EXTRA_DATA {
        bigint id PK
        bigint shipment_id FK
        varchar data_key
        varchar data_value
        datetime created_at
    }

    ORG {
        int id PK
        tinyint type
        varchar name
        varchar code
        varchar accode
        varchar abn
        varchar address
        varchar suburb
        varchar state
        varchar postcode
        varchar country
        varchar email
        varchar phone
        text desc
        tinyint status
        text mdata
    }

    USER {
        int id PK
        int type
        int org_id FK
        varchar title
        varchar fname
        varchar lname
        varchar email
        varchar password
        varchar phone
        datetime since
        tinyint status
        json mdata
        int depot_id
        int address_id FK
    }

    ADDRESS {
        bigint id PK
        varchar name
        varchar company
        varchar address
        varchar suburb
        varchar city
        varchar state
        varchar postcode
        varchar country
        varchar phone
        varchar email
    }

    LOG {
        bigint id PK
        timestamp time
        tinyint type
        varchar model
        bigint lid
        json mdata
        int user_id
    }

    MANIFEST {
        bigint id PK
        varchar manifest_no
        int customer_id FK
        int depot_id
        int created_by FK
        tinyint service_type
        tinyint status
        tinyint pickup_required
        bigint pickup_address_id
        datetime pickup_time_from
        datetime pickup_time_to
        int total_shipments
        int total_packages
        decimal total_weight
        decimal total_cbm
        datetime created_at
        datetime received_at
        datetime closed_at
        json meta
    }

    MANIFEST_SHIPMENT {
        bigint id PK
        bigint manifest_id FK
        bigint shipment_id FK
        tinyint status
        datetime created_at
    }